# Runtime environment
APP_ENV=development

# Backend database
# DATABASE_URL=sqlite:///./voting.db

# CORS (comma-delimited)
CORS_ORIGINS=http://localhost:5173
ALLOW_CREDENTIALS=true

# Local dev convenience. Keep false in production.
AUTO_CREATE_TABLES=false

# Auth
AUTH_SECRET_KEY=change-this-in-production
AUTH_ALGORITHM=HS256
AUTH_TOKEN_TTL_MINUTES=120
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_LOGIN_LOCKOUT_SECONDS=300
